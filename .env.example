# Host port for the Linux afsim-gen service.
# Port 8000 is often occupied by local dev servers, so compose defaults to 18006.
AFSIM_GEN_PORT=18006

# Default mode when building the service image FROM afsim:2.9.0.
EXECUTOR_MODE=local
AFSIM_INSTALL_DIR=/opt/afsim
MISSION_EXE=/opt/afsim/bin/mission
AFSIM_RUNNER_URL=

# Windows runner fallback:
# EXECUTOR_MODE=remote
# AFSIM_RUNNER_URL=http://windows-runner-host:9001

# OpenAI-compatible LLM endpoint.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=300
MAX_RETRIES=10
DEFAULT_END_TIME_SEC=7200
DEFAULT_ROUTE_SPEED=450 kts
